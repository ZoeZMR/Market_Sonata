# Copy this file to backend/.env and fill in your key to enable the
# AI-written programme note (Claude writes it from the real price history and
# the finished score — see backend/analyst.py). Without it, the page falls back
# to the grounded rule-based note automatically.
ANTHROPIC_API_KEY=

